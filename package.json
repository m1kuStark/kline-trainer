{
  "name": "a-share-kline-trainer",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run typecheck:web && npm run build:server && npm run build:web",
    "typecheck:web": "vue-tsc --noEmit -p web/tsconfig.json",
    "build:server": "tsc -p server/tsconfig.json",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "node server/dist/index.js",
    "test": "vitest run --config server/vitest.config.ts",
    "test:watch": "vitest --config server/vitest.config.ts",
    "verify:m2": "npm test && npm run build && npx --no-install tsx scripts/verify-m2.ts",
    "build:journey": "tsx scripts/runtime.ts build-journey",
    "journey": "tsx scripts/runtime.ts journey",
    "agent:dev": "tsx scripts/runtime.ts preview",
    "release:windows": "tsx scripts/release/build.mjs",
    "release:source": "node scripts/release/export-source.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^10.1.3",
    "fastify": "^5.6.0",
    "klinecharts": "10.0.3",
    "lucide-vue-next": "^0.577.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.3.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.3.11"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/m1kuStark/kline-trainer.git"
  }
}
